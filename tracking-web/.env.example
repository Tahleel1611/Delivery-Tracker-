# Server-side API address. Use http://api:3000 when both services run in Docker.
TRACKING_API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://tracking:tracking_password@localhost:5432/tracking?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
EMAIL_FROM=OMS <no-reply@example.com>
EMAIL_SERVER=smtp://localhost:1025
OCI_S3_ENDPOINT=https://your-namespace.compat.objectstorage.us-phoenix-1.oraclecloud.com
OCI_S3_REGION=us-phoenix-1
OCI_S3_BUCKET=delivery-pod
OCI_S3_ACCESS_KEY=replace-with-oci-customer-secret-key
OCI_S3_SECRET_KEY=replace-with-oci-customer-secret
POD_MAX_FILE_SIZE_BYTES=10485760
TRACKING_WEB_BASE_URL=http://localhost:3001
