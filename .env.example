NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://tracking:tracking_password@localhost:5432/tracking?schema=public
LEGACY_WEBHOOK_API_KEY=replace-with-a-long-random-key
DRIVER_JWT_SECRET=replace-with-at-least-32-random-characters
DRIVER_JWT_TTL=15m
DRIVER_REFRESH_TTL_DAYS=30
DRIVER_LOGIN_MAX_FAILURES=5
DRIVER_LOGIN_LOCK_MINUTES=15
CORS_ORIGIN=http://localhost:3000
TRACKING_WEB_BASE_URL=http://localhost:3001
TRACKING_TOKEN_TTL_DAYS=30
OCI_S3_ENDPOINT=https://your-namespace.compat.objectstorage.us-phoenix-1.oraclecloud.com
OCI_S3_REGION=us-phoenix-1
OCI_S3_NAMESPACE=your-object-storage-namespace
OCI_S3_BUCKET=delivery-pod
OCI_S3_ACCESS_KEY=replace-with-oci-customer-secret-key
OCI_S3_SECRET_KEY=replace-with-oci-customer-secret
POD_MAX_FILE_SIZE_BYTES=5242880
LOG_LEVEL=info
