generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryStatus {
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum WebhookReceiptStatus {
  PROCESSED
  FAILED
}

model Driver {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(160)
  phone          String         @db.VarChar(32)
  status         DriverStatus   @default(ACTIVE)
  vehicleDetails Json?          @map("vehicle_details")
  deliveries     Delivery[]
  statusLogs     DeliveryStatusLog[]
  credential     DriverCredential?
  sessions       DriverSession[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("drivers")
}

model Delivery {
  id               String              @id @default(uuid()) @db.Uuid
  orderRef         String              @unique @map("order_ref") @db.VarChar(120)
  customerPhone    String              @map("customer_phone") @db.VarChar(32)
  deliveryAddress  String              @map("delivery_address") @db.Text
  status           DeliveryStatus      @default(READY_FOR_DISPATCH)
  assignedDriverId String?             @map("assigned_driver_id") @db.Uuid
  assignedDriver   Driver?             @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  statusLogs       DeliveryStatusLog[]
  trackingToken    TrackingToken?
  podObjectKey     String?             @map("pod_object_key") @db.Text
  notificationAttempts NotificationAttempt[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([assignedDriverId])
  @@index([status])
  @@map("deliveries")
}

model TrackingToken {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  deliveryId String   @unique @map("delivery_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("tracking_tokens")
}

model DriverCredential {
  id             String   @id @default(uuid()) @db.Uuid
  driverId       String   @unique @map("driver_id") @db.Uuid
  username       String   @unique @db.VarChar(120)
  passwordHash   String   @map("password_hash") @db.Text
  failedAttempts Int      @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  driver         Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_credentials")
}

model DriverSession {
  id           String   @id @default(uuid()) @db.Uuid
  driverId     String   @map("driver_id") @db.Uuid
  refreshHash  String   @unique @map("refresh_hash") @db.Char(64)
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")
  driver       Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, expiresAt])
  @@map("driver_sessions")
}

enum NotificationAttemptStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

model NotificationAttempt {
  id             String                    @id @default(uuid()) @db.Uuid
  deliveryId     String                    @map("delivery_id") @db.Uuid
  status         DeliveryStatus
  provider       String                    @default("mock") @db.VarChar(40)
  state          NotificationAttemptStatus @default(PENDING)
  attemptCount   Int                       @default(0) @map("attempt_count")
  lastError      String?                   @map("last_error") @db.Text
  sentAt         DateTime?                 @map("sent_at")
  nextAttemptAt  DateTime                  @default(now()) @map("next_attempt_at")
  idempotencyKey String                    @unique @map("idempotency_key") @db.VarChar(180)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  delivery       Delivery                  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, status])
  @@index([state, nextAttemptAt])
  @@map("notification_attempts")
}

model DeliveryStatusLog {
  id         String         @id @default(uuid()) @db.Uuid
  deliveryId String         @map("delivery_id") @db.Uuid
  status     DeliveryStatus
  timestamp  DateTime       @default(now())
  lat        Decimal?       @db.Decimal(9, 6)
  lng        Decimal?       @db.Decimal(9, 6)
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverId   String?        @map("driver_id") @db.Uuid
  driver     Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([deliveryId, timestamp])
  @@map("delivery_status_logs")
}

model WebhookReceipt {
  id          String               @id @default(uuid()) @db.Uuid
  payloadHash String               @unique @map("payload_hash") @db.VarChar(64)
  sourceEventId String?            @unique @map("source_event_id") @db.VarChar(160)
  eventType   String?              @map("event_type") @db.VarChar(80)
  failureReason String?            @map("failure_reason") @db.Text
  status      WebhookReceiptStatus @default(PROCESSED)
  processedAt DateTime?            @map("processed_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("webhook_receipts")
}
