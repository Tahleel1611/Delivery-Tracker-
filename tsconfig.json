{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "Node16",
    "module": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
